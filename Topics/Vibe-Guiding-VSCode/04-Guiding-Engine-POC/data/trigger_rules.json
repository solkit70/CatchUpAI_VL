{
  "rules": [
    {
      "id": "cli_missing",
      "priority": 100,
      "match_types": ["cli_missing"],
      "keywords": ["gobi 명령", "command not found", "not recognized", "찾을 수 없습니다"],
      "guide_type": "install",
      "reason": "GOBI CLI가 설치되어 있지 않거나 PATH에 반영되지 않았습니다."
    },
    {
      "id": "auth_required",
      "priority": 90,
      "match_types": ["auth_required"],
      "keywords": ["auth", "login", "로그인", "인증", "logged out"],
      "guide_type": "auth",
      "reason": "GOBI CLI 인증 상태가 작업을 진행하기에 충분하지 않습니다."
    },
    {
      "id": "old_thread_command_used",
      "priority": 85,
      "match_types": ["old_thread_command_used", "space_post_blocked"],
      "keywords": ["thread", "create-thread", "list-threads", "get-thread", "Thread"],
      "guide_type": "space_post",
      "reason": "GOBI CLI v2.0.12에서는 Thread 명령어가 Post 명령어로 변경되었습니다."
    },
    {
      "id": "space_post_blocked",
      "priority": 80,
      "match_types": ["space_post_blocked"],
      "keywords": ["space", "post", "글", "게시", "create-post"],
      "guide_type": "space_post",
      "reason": "Space에 Post를 작성하는 절차 안내가 필요합니다."
    },
    {
      "id": "vault_publish_blocked",
      "priority": 70,
      "match_types": ["vault_publish_blocked"],
      "keywords": ["publish", "PUBLISH.md", "BRAIN.md", "vault publish"],
      "guide_type": "vault_publish",
      "reason": "Vault 발행 또는 PUBLISH.md 전환 안내가 필요합니다."
    },
    {
      "id": "desktop_applet_context_missing",
      "priority": 65,
      "match_types": ["desktop_applet_context_missing", "desktop_custom_homepage_blocked"],
      "keywords": ["custom homepage", "applet", "vault path", "설정", "메뉴", "홈페이지"],
      "guide_type": "desktop_applet",
      "reason": "GOBI Desktop Applet 안내 전에 실제 앱 버전, Vault Path, Applet 경로를 확인해야 합니다."
    },
    {
      "id": "environment_version_mismatch",
      "priority": 60,
      "match_types": ["version_mismatch", "environment_mismatch"],
      "keywords": ["version", "버전", "node", "npm", "2.0.12", "mismatch", "환경"],
      "guide_type": "environment_check",
      "reason": "사용자 환경과 매뉴얼 기준 버전이 다를 수 있으므로 먼저 버전과 실행 환경을 확인해야 합니다."
    }
  ]
}
