{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://live-comc-app/schemas/session_state.schema.json",
  "title": "session_state",
  "description": "3시간 방송 세션의 런타임 상태. wake 게이트, 활성 프로바이더, 남은 시간 등 파이프라인 전 단계가 공유하는 상태.",
  "type": "object",
  "properties": {
    "session_id": { "type": "string", "description": "세션 고유 id" },
    "started_at": { "type": "string", "format": "date-time" },
    "current_part_id": {
      "type": ["string", "null"],
      "description": "현재 파트 id. 방송 시작 전이면 null"
    },
    "wake_gate": {
      "type": "string",
      "enum": ["open", "closed"],
      "description": "호출어 감지 게이트. TTS 재생 중에는 closed로 에코 루프 차단 (M4에서 구현)"
    },
    "active_provider": {
      "type": "string",
      "enum": ["openai", "claude", "gemini"],
      "description": "현재 선택된 LLM 프로바이더 (교체 가능)"
    },
    "trace_path": {
      "type": "string",
      "description": "session_trace.jsonl 경로 — 모든 단계가 append 기록"
    },
    "remaining_seconds": {
      "type": ["integer", "null"],
      "description": "현재 파트 잔여 시간(초). conditional_sections 편입 판정에 사용. 미정이면 null"
    },
    "hitl_pending": {
      "type": "boolean",
      "description": "진행자 결정 대기(Human-in-the-Loop) 상태 여부"
    }
  },
  "required": ["session_id", "started_at", "wake_gate", "active_provider", "trace_path", "hitl_pending"],
  "additionalProperties": false
}
